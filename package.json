{
  "name": "@zephinel/dsh-intelligent-ui",
  "version": "0.2.2-26-10-21",
  "description": "Intelligent UI for DeepSeek Harness: render OpenUI Lang answers as interactive maps, photos, charts, forms, drawings, working tools or a reading article inside the Web chat. Global defaults live on the Plugins detail page; the composer overrides enablement and answer style per session.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./skills/*": "./skills/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "skills",
    "locale",
    "licenses",
    "icon.svg",
    "assets",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "icon": "./icon.svg",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:host": "node scripts/build.mjs host",
    "build:client": "node scripts/build.mjs client",
    "build:prompt": "node scripts/generate-prompt.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/host/*.test.mjs test/client/*.test.mjs test/packaging/*.test.mjs",
    "test:renderer": "node test/renderer/check.mjs && node test/renderer/render-check.mjs && node test/renderer/contrast-check.mjs && node test/renderer/i18n-check.mjs && node test/renderer/typography-check.mjs",
    "check": "npm run build && npm test && npm run test:renderer",
    "pack:check": "npm pack --dry-run --json",
    "prepare": "node scripts/build.mjs",
    "check:theme": "node test/renderer/theme-torture.mjs",
    "test:browser": "node test/browser/style-panel.e2e.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "intelligent-ui",
    "generative-ui",
    "openui",
    "openui-lang",
    "agent-ui"
  ],
  "author": "Zephinel",
  "license": "MIT",
  "homepage": "https://github.com/Zephinel/dsh-intelligent-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zephinel/dsh-intelligent-ui.git"
  },
  "bugs": {
    "url": "https://github.com/Zephinel/dsh-intelligent-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@openuidev/lang-core": "^1.0.1",
    "@openuidev/react-lang": "^1.0.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.0",
    "katex": "^0.16.47",
    "lucide-react": "^0.562.0",
    "maplibre-gl": "^6.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.0",
    "zod": "^4.0.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  }
}
